{
  "name": "kruegge82/ebay-sell-php-sdk",
  "description": "eBay Sell APIs (Fulfillment, Inventory, Account) - generiert mit openapi-generator",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "kruegge82\\ebay\\Fulfillment\\": "lib/Fulfillment/",
      "kruegge82\\ebay\\Inventory\\": "lib/Inventory/",
      "kruegge82\\ebay\\Account\\": "lib/Account/"
    }
  }
}
